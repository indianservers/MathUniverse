import {describe,it,expect} from 'vitest';
import {SK_MODELS,SK_WORKED,SK_PRACTICE,SK_CAMERA,skAnalyze,skParse,skProjection,skScene,skGrade} from './skewLineModel';
import {lpScale,lpCross,lpSub,lpNorm} from './linePlaneAngleModel';
describe('skew-line classification and projections',()=>{
 it('classifies every preset and gives a genuine coordinate contradiction for the default pair',()=>{for(const [kind,m] of Object.entries(SK_MODELS))expect(skAnalyze(m).relation).toBe(kind);const c=skAnalyze(SK_MODELS.Skew);expect(c.testCross).toEqual({x:0,y:0,z:1});expect(c.testTriple).toBe(1);expect(c.coplanar).toBe(false);expect(c.certificate).toEqual({first:0,second:1,remaining:2,left:0,right:1,s:0,t:-1});expect(skAnalyze(SK_MODELS.Coincident).coplanar).toBe(true);expect(skAnalyze(SK_MODELS.Parallel).distance).toBeGreaterThan(0);});
 it('projects the true y-parallel line to a line in xy and a point in xz',()=>{const xy=skProjection(SK_MODELS.Skew,'xy');expect(xy.intersect).toBe(true);expect(xy.kind).toBe('Intersecting projections');expect(xy.point).toEqual({x:0,y:0});expect(xy.two).toHaveLength(2);expect(xy.two.every(p=>p.x===0)).toBe(true);const xz=skProjection(SK_MODELS.Skew,'xz');expect(xz.vn).toBe(0);expect(xz.b).toEqual({x:0,y:1});expect(xz.intersect).toBe(false);expect(xz.two).toEqual([]);expect(skProjection(SK_MODELS.Skew,'yz').intersect).toBe(false);for(const plane of['xy','xz','yz'] as const)expect(skProjection(SK_MODELS.Intersecting,plane).intersect).toBe(true);expect(skProjection(SK_MODELS.Coincident,'xy').kind).toBe('Coincident projections');});
 it('validates triples, scaled tiny directions and every fixed worked/practice answer',()=>{expect(skParse('(1/2, -2, 3e-2)')).toEqual({x:.5,y:-2,z:.03});for(const t of['','(1,,3)','(11,0,0)','(Infinity,0,0)','(1,2)','1/0,2,3'])expect(skParse(t)).toBeNull();const tiny={...SK_MODELS.Skew,u:lpScale(SK_MODELS.Skew.u,1e-200),v:lpScale(SK_MODELS.Skew.v,1e-200)},c=skAnalyze(tiny);expect(c.relation).toBe('Skew');expect(c.scaled).toBe(true);expect(c.testTriple).toBe(1);expect(c.testCross).toEqual({x:0,y:0,z:1});expect(skAnalyze({...SK_MODELS.Skew,u:{x:0,y:0,z:0}}).valid).toBe(false);expect(skAnalyze(SK_WORKED).cross).toEqual({x:-9,y:0,z:6});expect(skAnalyze(SK_WORKED).triple).toBe(-9);expect(SK_PRACTICE.map(m=>skAnalyze(m).relation)).toEqual(['Coincident','Coincident','Skew']);expect(skGrade(1,'Parallel').correct).toBe(false);expect(skGrade(1,'Coincident').correct).toBe(true);});
 it('keeps scene lines and reference-plane vertices in their actual spaces',()=>{for(const plane of['xy','xz','yz'] as const){const g=skScene(SK_MODELS.Skew,SK_CAMERA,plane);for(const p of g.planePoints)expect(p[g.fixed]).toBe(0);for(const [line,anchor,direction]of[[g.one!,SK_MODELS.Skew.a,SK_MODELS.Skew.u],[g.two!,SK_MODELS.Skew.b,SK_MODELS.Skew.v]] as const)for(const p of line.points)expect(lpNorm(lpCross(lpSub(p,anchor),direction))).toBeCloseTo(0,12);}});
});
