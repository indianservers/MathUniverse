eight: 850; }.cas-sheet-export-grid button:hover { border-color: #818cf8; background: #eef2ff; color: #4338ca; }.cas-sheet-export-grid svg { width: 22px; height: 22px; }.cas-sheet-tabs { position: relative; display: flex; min-width: 0; align-items: stretch; gap: 0; border-top: 1px solid var(--sheet-border); background: #f8fafc; padding-left: 7px; }.cas-sheet-tabs > button { position: relative; display: flex; min-width: 44px; align-items: center; justify-content: center; gap: 5px; border-right: 1px solid #e2e8f0; padding: 0 18px; color: #475569; font-size: 11px; font-weight: 800; }.cas-sheet-tabs > button:first-child,.cas-sheet-tabs > button:last-of-type { min-width: 40px; padding: 0 10px; }.cas-sheet-tabs > button.is-active { background: #fff; color: #4338ca; box-shadow: inset 0 3px var(--tab-color, #4f46e5); }.cas-sheet-tabs button small { color: #a16207; font-size: 8px; }.cas-sheet-tabs svg { width: 15px; height: 15px; }.cas-sheet-tab-menu { position: absolute; z-index: 50; bottom: 44px; left: 6px; width: 180px; border: 1px solid var(--sheet-border); border-radius: 6px; background: #fff; padding: 6px; box-shadow: 0 16px 40px rgb(15 23 42 / .2); }.cas-sheet-tab-menu > button,.cas-sheet-tab-menu form { display: flex; width: 100%; min-height: 34px; align-items: center; border-radius: 4px; padding: 0 8px; font-size: 11px; font-weight: 750; }.cas-sheet-tab-menu > button:hover { background: #eef2ff; }.cas-sheet-tab-menu > button:disabled { opacity: .4; }.cas-sheet-tab-menu form { gap: 4px; padding: 4px; }.cas-sheet-tab-menu input { min-width: 0; width: 100%; border: 1px solid #cbd5e1; padding: 6px; }.cas-sheet-tab-menu form button { border-radius: 4px; background: #4f46e5; padding: 6px; color: #fff; }.cas-sheet-inspector { min-width: 0; min-height: 0; overflow: hidden; background: #f8fafc; }.cas-sheet-inspector-tabs { display: grid; height: 44px; grid-template-columns: repeat(3, 1fr) 36px; border-bottom: 1px solid var(--sheet-border); background: #fff; padding: 0 8px; }.cas-sheet-inspector-tabs button { position: relative; color: #475569; font-size: 11px; font-weight: 850; }.cas-sheet-inspector-tabs button.is-active { color: #4338ca; }.cas-sheet-inspector-tabs button.is-active::after { position: absolute; right: 9px; bottom: -1px; left: 9px; height: 2px; background: linear-gradient(90deg, #06b6d4, #7c3aed); content: \"\"; }.cas-sheet-inspector-tabs button:last-child { display: grid; place-items: center; }.cas-sheet-inspector-tabs svg { width: 15px; height: 15px; }.cas-sheet-inspector-scroll { height: calc(100% - 44px); overflow-y: auto; padding: 9px; }.cas-sheet-insight-block,.cas-sheet-property-card,.cas-sheet-ai-insight,.cas-sheet-comment-editor,.cas-sheet-object-list > button { border: 1px solid var(--sheet-border); border-radius: 7px; background: #fff; box-shadow: 0 4px 14px rgb(15 23 42 / .04); }.cas-sheet-insight-block,.cas-sheet-property-card,.cas-sheet-ai-insight { margin-bottom: 8px; padding: 11px; }.cas-sheet-insight-heading { display: flex; align-items: start; justify-content: space-between; gap: 8px; }.cas-sheet-insight-heading span,.cas-sheet-ai-insight > span { color: #4f46e5; font-size: 9px; font-weight: 900; text-transform: uppercase; }.cas-sheet-insight-heading h3,.cas-sheet-insight-block > h3 { margin-top: 2px; font-size: 13px; font-weight: 900; }.cas-sheet-insight-heading button { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 5px; background: #f1f5f9; }.cas-sheet-insight-heading svg { width: 14px; height: 14px; }.cas-sheet-regression-chart { display: block; width: 100%; height: 174px; margin-top: 8px; background: #fff; }.cas-sheet-regression-chart .grid line { stroke: #e2e8f0; stroke-width: .8; }.cas-sheet-regression-chart .axis { stroke: #64748b; stroke-width: 1; }.cas-sheet-regression-chart .fit { stroke: url(#regLine); stroke-width: 2.5; }.cas-sheet-regression-chart circle { fill: #06b6d4; stroke: white; stroke-width: 1.5; }.cas-sheet-regression-chart circle.selected { fill: #7c3aed; stroke: #ddd6fe; stroke-width: 3; }.cas-sheet-empty-chart { display: grid; height: 160px; place-items: center; color: #64748b; font-size: 11px; }.cas-sheet-regression-summary { border-top: 1px solid #e2e8f0; padding-top: 9px; }.cas-sheet-regression-summary > span { color: #64748b; font-size: 10px; font-weight: 750; }.cas-sheet-regression-summary > strong { display: block; margin-top: 5px; color: #7c3aed; font-size: 18px; font-weight: 850; }.cas-sheet-regression-summary > p { margin-top: 3px; color: #475569; font-size: 11px; }.cas-sheet-regression-summary > div { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 9px; }.cas-sheet-regression-summary button { min-height: 36px; border: 1px solid #60a5fa; border-radius: 5px; color: #2563eb; font-size: 10px; font-weight: 850; }.cas-sheet-regression-summary button:last-child { border: 0; background: linear-gradient(90deg, #06b6d4, #8b5cf6); color: #fff; }.cas-sheet-stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 5px; margin-top: 8px; }.cas-sheet-stat-grid > div { border: 1px solid #e2e8f0; border-radius: 5px; background: #f8fafc; padding: 7px; }.cas-sheet-stat-grid span,.cas-sheet-stat-grid strong { display: block; }.cas-sheet-stat-grid span { color: #64748b; font-size: 9px; font-weight: 750; }.cas-sheet-stat-grid strong { margin-top: 2px; font-size: 12px; }.cas-sheet-ai-insight { border-left: 3px solid #06b6d4; background: linear-gradient(135deg, #ecfeff, #f5f3ff); }.cas-sheet-ai-insight strong { display: block; margin-top: 7px; color: #0f766e; font-size: 12px; }.cas-sheet-ai-insight p { margin-top: 5px; color: #475569; font-size: 10px; line-height: 1.5; }.cas-sheet-property-card > div { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 9px; }.cas-sheet-property-card > div span { color: #64748b; font-size: 10px; font-weight: 800; }.cas-sheet-property-card > div strong { color: #4338ca; }.cas-sheet-property-card p { display: grid; grid-template-columns: 105px minmax(0,1fr); gap: 8px; border-bottom: 1px solid #eef2f7; padding: 7px 0; font-size: 10px; }.cas-sheet-property-card p span { color: #64748b; font-weight: 750; }.cas-sheet-property-card p strong { min-width: 0; overflow-wrap: anywhere; text-align: right; }.cas-sheet-comment-editor { display: block; padding: 10px; color: #475569; font-size: 10px; font-weight: 800; }.cas-sheet-comment-editor textarea { width: 100%; min-height: 74px; margin-top: 6px; resize: vertical; border: 1px solid #dbe3ee; border-radius: 5px; padding: 8px; font-size: 11px; font-weight: 500; }.cas-sheet-object-list { display: grid; gap: 6px; }.cas-sheet-object-list > button { position: relative; display: block; min-height: 72px; padding: 10px 38px 10px 10px; text-align: left; }.cas-sheet-object-list > button.is-active { border-color: #818cf8; background: #eef2ff; box-shadow: inset 3px 0 #4f46e5; }.cas-sheet-object-list span,.cas-sheet-object-list strong,.cas-sheet-object-list small { display: block; }.cas-sheet-object-list span { color: #7c3aed; font-size: 9px; font-weight: 850; text-transform: uppercase; }.cas-sheet-object-list strong { margin-top: 3px; font-size: 12px; }.cas-sheet-object-list small { margin-top: 3px; overflow: hidden; color: #64748b; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }.cas-sheet-object-list svg { position: absolute; top: 13px; right: 12px; width: 15px; height: 15px; color: #06b6d4; }.cas-sheet-open-inspector { position: fixed; z-index: 50; right: 8px; top: 50%; display: grid; width: 38px; height: 48px; place-items: center; border: 1px solid var(--sheet-border); border-radius: 6px 0 0 6px; background: #fff; box-shadow: 0 8px 20px rgb(15 23 42 / .16); }.cas-sheet-open-inspector svg { width: 17px; height: 17px; }.cas-sheet-status { gap: 0; overflow-x: auto; border-top: 1px solid var(--sheet-border); background: #fff; color: #475569; white-space: nowrap; }.cas-sheet-status > span { display: flex; height: 100%; align-items: center; border-right: 1px solid #e2e8f0; padding: 0 14px; font-size: 9px; font-weight: 750; }.cas-sheet-status > span:first-child { min-width: 110px; color: #0f766e; }.cas-sheet-status label { gap: 5px; margin-left: auto; padding: 0 8px; }.cas-sheet-status label button,.cas-sheet-status > button { display: grid; width: 28px; height: 28px; place-items: center; }.cas-sheet-status label input { width: 96px; accent-color: #4f46e5; }.cas-sheet-status svg { width: 13px; height: 13px; }.cas-sheet-status strong { min-width: 36px; font-size: 9px; text-align: center; }@media (max-width: 1100px) {\n  .cas-sheet-body.has-inspector { grid-template-columns: minmax(420px, 1fr) 300px; }\n  .cas-sheet-grid { grid-template-columns: 44px repeat(8, minmax(132px, 1fr)); }\n  .cas-sheet-header { grid-template-columns: minmax(190px, auto) 1fr auto; gap: 8px; }\n  .cas-sheet-brand small { display: none; }\n}@media (max-width: 760px) {\n  .cas-sheet-shell { grid-template-rows: 48px auto 48px minmax(0,1fr) 38px; }\n  .cas-sheet-header { grid-template-columns: minmax(150px, 1fr) auto; padding: 0 8px; }\n  .cas-sheet-brand strong { font-size: 13px; }\n  .cas-sheet-file-name { display: none; }\n  .cas-sheet-header-actions > button:nth-child(-n+2),.cas-sheet-header-actions > button:nth-child(4),.cas-sheet-header-actions > button:nth-child(6) { display: none; }\n  .cas-sheet-header-actions > button,.cas-sheet-profile > button { width: 34px; height: 34px; }\n  .cas-sheet-ribbon-tabs { overflow-x: auto; padding: 0 6px; }\n  .cas-sheet-ribbon-tabs button { min-width: 64px; min-height: 44px; }\n  .cas-sheet-ribbon-tools { min-height: 86px; padding: 5px; }\n  .cas-sheet-ribbon-group { min-width: 88px; padding: 0 4px; }\n  .cas-sheet-ribbon-group button { min-width: 52px; min-height: 58px; }\n  .cas-sheet-formula-bar { padding: 5px 4px; }\n  .cas-sheet-formula-bar .cas-sheet-name-box { width: 78px; min-height: 44px; }\n  .cas-sheet-formula-bar > button { width: 36px; min-height: 44