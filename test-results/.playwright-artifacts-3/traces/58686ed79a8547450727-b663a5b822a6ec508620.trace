           mask-image: linear-gradient(to bottom, black, transparent 86%);\n  }.formula-museum-stage {\n    position: relative;\n    min-height: 420px;\n    perspective: 900px;\n    transform-style: preserve-3d;\n  }.museum-floor {\n    position: absolute;\n    inset: auto 4% 16px;\n    height: 62%;\n    border: 1px solid rgba(125, 211, 252, 0.2);\n    border-radius: 28px;\n    background:\n      linear-gradient(rgba(125, 211, 252, 0.16) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(125, 211, 252, 0.12) 1px, transparent 1px),\n      linear-gradient(180deg, rgba(14, 116, 144, 0.12), rgba(88, 28, 135, 0.18));\n    background-size: 36px 36px, 36px 36px, auto;\n    box-shadow: inset 0 0 36px rgba(34, 211, 238, 0.14), 0 24px 80px rgba(0, 0, 0, 0.36);\n    transform: rotateX(64deg) translateZ(-42px);\n    transform-origin: center bottom;\n  }.museum-exhibit {\n    position: absolute;\n    display: block;\n    border: 1px solid rgba(255, 255, 255, 0.16);\n    background: rgba(255, 255, 255, 0.08);\n    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28), inset 0 0 26px rgba(255, 255, 255, 0.08);\n    backdrop-filter: blur(10px);\n  }.museum-label {\n    position: absolute;\n    left: 12px;\n    bottom: 10px;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;\n    font-size: 0.75rem;\n    font-weight: 900;\n    color: #cffafe;\n  }.museum-exhibit.museum-derivative {\n    left: 7%;\n    top: 18%;\n    width: 36%;\n    height: 34%;\n    border-radius: 22px;\n    transform: rotateY(-18deg) rotateX(8deg);\n  }.museum-curve {\n    position: absolute;\n    left: 12%;\n    right: 12%;\n    top: 50%;\n    height: 56px;\n    border-top: 7px solid #22d3ee;\n    border-radius: 50%;\n    transform: rotate(-9deg);\n    filter: drop-shadow(0 0 16px rgba(34, 211, 238, 0.72));\n  }.museum-tangent {\n    position: absolute;\n    left: 18%;\n    right: 16%;\n    top: 47%;\n    height: 4px;\n    border-radius: 999px;\n    background: #facc15;\n    box-shadow: 0 0 18px rgba(250, 204, 21, 0.8);\n    transform: rotate(-18deg);\n    animation: museum-tangent-drift 5s ease-in-out infinite;\n  }.museum-exhibit.museum-integral {\n    right: 8%;\n    top: 10%;\n    width: 38%;\n    height: 42%;\n    border-radius: 24px;\n    transform: rotateY(16deg) rotateX(7deg);\n  }.museum-exhibit.museum-integral > span:not(.museum-label) {\n    position: absolute;\n    bottom: 42px;\n    left: calc(12% + var(--i) * 9%);\n    width: 7%;\n    height: calc(32px + var(--i) * 8px);\n    border: 1px solid rgba(103, 232, 249, 0.42);\n    border-radius: 8px 8px 2px 2px;\n    background: linear-gradient(180deg, rgba(34, 211, 238, 0.55), rgba(168, 85, 247, 0.22));\n    box-shadow: 0 0 16px rgba(34, 211, 238, 0.22);\n  }.museum-exhibit.museum-matrix {\n    left: 15%;\n    bottom: 13%;\n    width: 32%;\n    height: 30%;\n    border-radius: 20px;\n    transform: rotateY(20deg) rotateX(14deg) rotateZ(-3deg);\n  }.museum-exhibit.museum-matrix > span:not(.museum-label) {\n    position: absolute;\n    border: 2px solid rgba(196, 181, 253, 0.6);\n    background: rgba(139, 92, 246, 0.18);\n  }.museum-exhibit.museum-matrix > span:nth-child(1) {\n    inset: 18% 55% 52% 12%;\n  }.museum-exhibit.museum-matrix > span:nth-child(2) {\n    inset: 18% 14% 52% 53%;\n  }.museum-exhibit.museum-matrix > span:nth-child(3) {\n    inset: 52% 26% 16% 24%;\n    transform: skewX(-18deg);\n  }.museum-exhibit.museum-probability {\n    right: 13%;\n    bottom: 11%;\n    width: 34%;\n    height: 30%;\n    border-radius: 999px 28px 28px 999px;\n    transform: rotateY(-14deg) rotateX(12deg);\n  }.museum-exhibit.museum-probability > span:not(.museum-label) {\n    position: absolute;\n    height: 4px;\n    border-radius: 999px;\n    background: #34d399;\n    box-shadow: 0 0 15px rgba(52, 211, 153, 0.55);\n    transform-origin: left center;\n  }.museum-exhibit.museum-probability > span:nth-child(1) {\n    left: 18%;\n    top: 50%;\n    width: 58%;\n    transform