ctions svg { width: 17px; height: 17px; }.cas-header-actions .cas-avatar { width: 32px; min-width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg,#22d3ee,#7c3aed); color: white; }.cas-mobile-menu { display: none !important; }.cas-global-search { display: flex; width: min(190px,16vw); height: 34px; align-items: center; gap: 7px; border: 1px solid #dbe5f0; border-radius: 8px; background: #f8fafc; padding: 0 9px; color: #64748b; }.cas-global-search svg { width: 16px; }.cas-global-search input { min-width: 0; width: 100%; border: 0; background: transparent; outline: none; color: #0f172a; }.cas-studio-v2 .cas-studio-modebar {\n    grid-area: modules;\n    display: flex;\n    min-width: 0;\n    align-items: center;\n    gap: 2px;\n    overflow-x: auto;\n    border: 0;\n    border-bottom: 1px solid #dbe5f0;\n    border-radius: 0;\n    background: #fff;\n    padding: 5px 7px;\n    box-shadow: none;\n    scrollbar-width: none;\n  }.cas-studio-v2 .cas-studio-modebar button { display: inline-flex; min-height: 36px; flex: 1 0 auto; align-items: center; justify-content: center; gap: 6px; border: 0; border-radius: 7px; background: transparent; padding: 0 11px; box-shadow: none; color: #334155; font-size: 12px; font-weight: 780; }.cas-studio-v2 .cas-studio-modebar button:hover { background: #f1f5f9; color: #0e7490; }.cas-studio-v2 .cas-studio-modebar button.is-active { background: linear-gradient(110deg,#0ea5e9,#7c3aed); color: #fff; box-shadow: 0 6px 14px rgb(79 70 229 / .18); }.cas-studio-v2 .cas-studio-modebar button.is-disabled { background: #f8fafc; color: #94a3b8; cursor: not-allowed; }.cas-studio-v2 .cas-studio-modebar svg { width: 16px; height: 16px; }.cas-studio-v2 .cas-studio-left { grid-area: left; display: flex; gap: 9px; overflow: hidden; border-right: 1px solid #dbe5f0; background: #fbfdff; padding: 10px; }.cas-studio-v2 .cas-panel-heading h3 { font-size: 14px; }.cas-studio-v2 .cas-panel-heading p { color: #0e7490; font-size: 9px; }.cas-st