eight: 100dvh;\n  overflow-x: hidden;\n  background: radial-gradient(circle at 74% 15%, rgba(91, 68, 221, .2), transparent 29%), radial-gradient(circle at 22% 5%, rgba(6, 182, 212, .16), transparent 25%), #030914;\n  color: #f8fbff;\n  font-family: Inter, ui-sans-serif, system-ui, sans-serif;\n}\n.workspace-home-shell * { box-sizing: border-box; }\n.workspace-suite-bar {\n  position: relative;\n  z-index: 80;\n  min-height: 58px;\n  padding: 7px 14px;\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  border-bottom: 1px solid #203552;\n  background: linear-gradient(90deg, rgba(4, 19, 38, .98), rgba(8, 24, 49, .98));\n  color: #d9e5f1;\n}\n.workspace-suite-brand { min-width: 220px; display: flex; align-items: center; gap: 10px; color: white; text-decoration: none; }\n.workspace-suite-mark { width: 39px; height: 39px; display: grid; place-items: center; border: 1px solid #22d3ee66; border-radius: 9px; color: #071521; background: linear-gradient(145deg, #23d8ea, #6974ff); box-shadow: 0 0 25px #22d3ee25; }\n.workspace-suite-mark svg { width: 21px; }\n.workspace-suite-brand > span:last-child { display: flex; flex-direction: column; }\n.workspace-suite-brand strong { font-size: 14px; }\n.workspace-suite-brand small { color: #8fa3ba; font-size: 9px; letter-spacing: .6px; text-transform: uppercase; }\n.workspace-suite-bar nav { min-width: 0; flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px; overflow-x: auto; scrollbar-width: none; }\n.workspace-suite-bar nav a { min-height: 40px; padding: 0 13px; display: flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid transparent; border-radius: 7px; color: #aebfd0; text-decoration: none; font-size: 12px; font-weight: 700; white-space: nowrap; transition: .16s ease; }\n.workspace-suite-bar nav a svg { width: 16px; }\n.workspace-suite-bar nav a:hover { color: white; background: #102844; }\n.workspace-suite-bar nav a.is-active { color: white; border-color: #1bc9df77; background: linear-gradient(135deg, #0d7893, #2149a2); box-shadow: 0 7px 20px #071728; }\n.workspace-home-hero { min-height: 430px; max-width: 1460px; margin: 0 auto; padding: 54px 38px 34px; display: grid; grid-template-columns: minmax(420px, .82fr) minmax(560px, 1.18fr); align-items: center; gap: 58px; }\n.workspace-home-eyebrow { display: inline-flex; align-items: center; gap: 8px; color: #22d3ee; font-size: 11px; font-weight: 900; letter-spacing: 1.8px; }\n.workspace-home-eyebrow svg { width: 16px; }\n.workspace-home-copy h1 { margin: 13px 0 13px; font-size: clamp(42px, 4.2vw, 67px); line-height: .98; letter-spacing: -2.8px; }\n.workspace-home-copy h1 em { color: transparent; background: linear-gradient(90deg, #22d3ee, #8b78ff); -webkit-background-clip: text; background-clip: text; font-style: normal; }\n.workspace-home-copy p { max-width: 560px; margin: 0; color: #9eb0c3; font-size: 16px; line-height: 1.65; }\n.workspace-home-actions { display: flex; gap: 10px; margin-top: 25px; }\n.workspace-home-actions a { height: 43px; padding: 0 16px; display: inline-flex; align-items: center; gap: 8px; border: 1px solid #294866; border-radius: 7px; color: white; background: #0a1e35; text-decoration: none; font-size: 12px; font-weight: 800; }\n.workspace-home-actions a:first-child { border-color: #1ed6e9; color: #061521; background: linear-gradient(90deg, #20d5e9, #6b80ff); }\n.workspace-home-actions svg { width: 16px; }\n.workspace-home-preview { position: relative; height: 330px; overflow: hidden; border: 1px solid #2b4965; border-radius: 14px; background: #07192e; box-shadow: 0 28px 70px #0008, inset 0 1px #ffffff0d; }\n.workspace-preview-grid { position: absolute; inset: 0; opacity: .35; background-image: linear-gradient(#28445d 1px, transparent 1px), linear-gradient(90deg, #28445d 1px, transparent 1px); background-size: 38px 38px; }\n.workspace-home-preview svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n.workspace-preview-curve { fill: none; stroke: #22d3ee; stroke-width: 4; filter: drop-shadow(0 0 8px #22d3ee88); }\n.workspace-preview-shape { fill: #7c5cfb18; stroke: #8d77ff; stroke-width: 3; }\n.workspace-home-preview circle { fill: white; stroke: #f7b84b; stroke-width: 3; }\n.workspace-preview-surface { fill: none; stroke: #f7b84b; stroke-width: 2.2; }\n.workspace-preview-formula { position: absolute; top: 15px; left: 15px; height: 40px; padding: 0 12px; display: flex; align-items: center; gap: 8px; border: 1px solid #2c4c68; border-radius: 7px; background: #071526e8; color: #dbe8f3; font-family: Georgia, serif; }\n.workspace-preview-formula svg { position: static; width: 17px; color: #20d6e9; }\n.workspace-preview-status { position: absolute; right: 14px; bottom: 12px; padding: 7px 10px; display: flex; align-items: center; gap: 7px; border: 1px solid #28506a; border-radius: 20px; color: #9edbe4; background: #071526df; font-size: 10px; font-weight: 700; }\n.workspace-preview-status i { width: 7px; height: 7px; border-radius: 50%; background: #22d3ee; box-shadow: 0 0 8px #22d3ee; }\n.workspace-home-tools { max-width: 1460px; margin: 0 auto; padding: 22px 38px 48px; }\n.workspace-home-tools > header { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 18px; }\n.workspace-home-tools header span { color: #1dd6e9; font-size: 10px; font-weight: 900; letter-spacing: 1.6px; }\n.workspace-home-tools h2 { margin: 4px 0 0; font-size: 27px; }\n.workspace-home-tools header p { max-width: 510px; margin: 0; color: #91a5ba; font-size: 12px; line-height: 1.55; }\n.workspace-home-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.workspace-home-card { position: relative; min-height: 168px; overflow: hidden; padding: 18px; display: grid; grid-template-columns: 54px 1fr; gap: 13px; border: 1px solid #294762; border-radius: 10px; color: white; background: linear-gradient(145deg, #0b2038, #07192d); text-decoration: none; transition: transform .18s ease, border-color .18s ease; }\n.workspace-home-card::before { content: \"\"; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--card-accent); }\n.workspace-home-card:hover { transform: translateY(-3px); border-color: var(--card-accent); }\n.workspace-home-card-icon { width: 54px; height: 54px; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--card-accent) 70%, white 5%); border-radius: 10px; color: var(--card-accent); background: color-mix(in srgb, var(--card-accent) 14%, transparent); }\n.workspace-home-card-icon svg { width: 27px; }\n.workspace-home-card-content { min-width: 0; display: flex; flex-direction: column; }\n.workspace-home-card-content small { color: var(--card-accent); font-size: 9px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; }\n.workspace-home-card-content strong { margin-top: 3px; font-size: 18px; }\n.workspace-home-card-content > span { margin-top: 5px; color: #9caec0; font-size: 11px; line-height: 1.45; }\n.workspace-home-card-open { grid-column: 1 / -1; align-self: end; display: inline-flex; align-items: center; gap: 5px; color: var(--card-accent); font-size: 11px; font-weight: 850; white-space: nowrap; }\n.workspace-home-card-open svg { width: 14px; }\n.workspace-home-card-formula { position: absolute; right: 14px; bottom: 11px; color: #ffffff10; font: 700 25px Georgia, serif; }\n@media (max-width: 1100px) {\n  .workspace-suite-brand { min-width: 175px; }.workspace-suite-bar nav { justify-content: flex-start; }.workspace-suite-bar nav a { padding-inline: 10px; }.workspace-home-hero { grid-template-columns: 1fr 1.1fr; gap: 28px; }.workspace-home-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 760px) {\n  .workspace-suite-bar { display: block; padding: 7px 9px; }.workspace-suite-brand { display: none; }.workspace-suite-bar nav { justify-content: flex-start; }.workspace-suite-bar nav a { min-width: 74px; flex-direction: column; gap: 1px; padding: 4px 8px; font-size: 9px; }\n  .workspace-home-hero { padding: 34px 18px 26px; grid-template-columns: 1fr; }.workspace-home-copy h1 { font-size: 42px; }.workspace-home-preview { height: 270px; }.workspace-home-tools { padding: 20px 18px 35px; }.workspace-home-tools > header { display: block; }.workspace-home-tools header p { margin-top: 8px; }.workspace-home-grid { grid-template-columns: 1fr; }\n}\n@media (prefers-reduced-motion: reduce) { .workspace-home-card { transition: none; } }\n"],["STYLE",{},"@font-face{font-display:block;font-family:KaTeX_AMS;font-style:normal;font-weight:400;src:url(/node_modules/katex/dist/fonts/KaTeX_AMS-Regular.woff2) format(\"woff2\"),url(/node_modules/katex/dist/fonts/KaTeX_AMS-Regular.woff) format(\"woff\"),url(/node_modules/katex/dist/fonts/KaTeX_AMS-Regular.ttf) format(\"truetype\")}@font-face{font-display:block;font-family:KaTeX_Caligraphic;font-style:normal;font-weight:700;src:url(/node_modules/katex/dist/fonts/KaTeX_Caligraphic-Bold.woff2) format(\"woff2\"),url(/node_modules/katex/dist/fonts/KaTeX_Caligraphic-Bold.woff) format(\"woff\"),url(/node_modules/katex/dist/fonts/KaTeX_Caligraphic-Bold.ttf) format(\"truetype\")}@font-face{font-display:block;font-family:KaTeX_Caligraphic;font-style:normal;font-weight:400;src:url(/node_modules/katex/dist/fonts/KaTeX_Caligraphic-Regular.woff2) format(\"woff2\"),url(/node_modules/katex/dist/fonts/KaTeX_Caligraphic-Regular.woff) format(\"woff\"),url(/node_modules/katex/dist/fonts/KaTeX_Caligraphic-Regular.ttf) format(\"truetype\")}@font-face{font-display:block;font-family:KaTeX_Fraktur;font-style:normal;font-weight:700;src:url(/node_modules/katex/dist/fonts/KaTeX_Fraktur-Bold.woff2) format(\"woff2\"),url(/node_modules/katex/dist/fonts/KaTeX_Fraktur-Bold.woff) format(\"woff\"),url(/node_modules/katex/dist/fonts/KaTeX_Fraktur-Bold.ttf) format(\"truetype\")}@font-face{font-display:block;font-family:KaTeX_Fraktur;font-style:normal;font-weight:400;src:url(/node_modules/katex/dist/fonts/KaTeX_Fraktur-Regul