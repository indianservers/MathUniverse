en; overflow: hidden; border: 1px solid var(--sheet-border); border-radius: 5px; background: #fff; font-weight: 800; }.cas-sheet-name-box input { min-width: 0; width: 100%; height: 100%; padding: 0 8px; background: transparent; font-size: 11px; font-weight: 800; text-transform: uppercase; }.cas-sheet-name-box button { display: grid; width: 28px; height: 100%; flex: none; place-items: center; }.cas-sheet-name-box svg { width: 13px !important; }.cas-sheet-formula-bar .cas-sheet-fx { border: 0; background: transparent; color: #334155; }.cas-sheet-formula-input { min-width: 0; flex: 1; }.cas-sheet-formula-input textarea { width: 100%; height: 36px; resize: none; border: 1px solid var(--sheet-border); border-radius: 5px; background: #fff; padding: 8px 12px; color: #0f172a; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; line-height: 18px; }.cas-sheet-formula-bar.is-expanded { min-height: 94px; align-items: start; }.cas-sheet-formula-bar.is-expanded .cas-sheet-formula-input textarea { height: 82px; }.cas-sheet-formula-input textarea[aria-invalid=\"true\"] { border-color: #f59e0b; }.cas-sheet-formula-error { position: absolute; z-index: 12; top: 44px; right: 12px; border: 1px solid #fed7aa; border-radius: 5px; background: #fff7ed; padding: 5px 8px; color: #9a3412; font-size: 10px; font-weight: 750; box-shadow: 0 8px 20px rgb(124 45 18 / .12); }.cas-sheet-body { display: grid; min-height: 0; grid-template-columns: minmax(0, 1fr); }.cas-sheet-body.has-inspector { grid-template-columns: minmax(500px, 1fr) 340px; }.cas-sheet-main { position: relative; display: grid; min-width: 0; min-height: 0; grid-template-rows: minmax(0, 1fr) 43px; border-right: 1px solid var(--sheet-border); background: #fff; }.cas-sheet-search { position: absolute; z-index: 12; top: 0; right: 0; left: 0; gap: 7px; border-bottom: 1px solid var(--sheet-border); background: #eff6ff; padding: 6px 10px; box-shadow: 0 6px 14px rgb(15 23 42 / .08); }.cas-sheet-search svg { width: 15px; height: 15px; color: #2563eb; }.cas-sheet-search input { min-width: 0; flex: 1; border: 1px solid #bfdbfe; border-radius: 5px; background: white; padding: 6px 9px; font-size: 11px; }.cas-sheet-search span { color: #64748b; font-size: 10px; font-weight: 700; }.cas-sheet-search button { width: 28px; height: 28px; }.cas-sheet-grid-scroll { min-width: 0; min-height: 0; overflow: auto; background: #fff; }.cas-sheet-grid { display: grid; width: -moz-max-content; width: max-content; min-width: 100%; grid-template-columns: 48px repeat(8, minmax(150px, 1fr)); grid-auto-rows: calc(34px * var(--sheet-zoom, 1)); outline: 0; transform-origin: top left; }.cas-sheet-shell.is-compact .cas-sheet-grid { grid-auto-rows: calc(28px * var(--sheet-zoom, 1)); }.cas-sheet-corner,.cas-sheet-column-header,.cas-sheet-row-header,.cas-sheet-cell { box-sizing: border-box; border: 0; background: #fff; }.cas-sheet-grid.show-gridlines .cas-sheet-corner,.cas-sheet-grid.show-gridlines .cas-sheet-column-header,.cas-sheet-grid.show-gridlines .cas-sheet-row-header,.cas-sheet-grid.show-gridlines .cas-sheet-cell { border-right: 1px solid #dce4ee; border-bottom: 1px solid #dce4ee; }.cas-sheet-corner,.cas-sheet-column-header { position: sticky; z-index: 8; top: 0; background: #f4f7fb; }.cas-sheet-corner { left: 0; display: grid; place-items: center; color: #64748b; }.cas-sheet-corner svg { width: 14px; height: 14px; }.cas-sheet-column-header { resize: horizontal; overflow: hidden; color: #334155; font-size: 12px; font-weight: 850; text-align: center; }.cas-sheet-column-header span { position: absolute; right: 0; top: 0; width: 4px; height: 100%; cursor: col-resize; }.cas-sheet-row-header { position: sticky; z-index: 7; left: 0; background: #f7f9fc; color: #64748b; font-size: 11px; font-weight: 800; text-align: center; }.cas-sheet-cell { position: relative; display: flex; min-width: 0; align-items: center; padding: 0 10px; color: #1e293b; font-size: 12px; line-height: 1.25; cursor: cell; }.cas-sheet-cell 