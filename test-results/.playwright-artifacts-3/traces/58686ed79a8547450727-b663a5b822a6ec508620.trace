1fr; gap: 5px; }.shapes-compare-grid dl div { border-radius: 4px; background: rgba(148,163,184,.08); padding: 6px; }.shapes-compare-grid dt { color: #8096aa; font-size: 8px; }.shapes-compare-grid dd { margin-top: 2px; color: white; font-size: 11px; font-weight: 900; }.shapes-learning-path { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin: 16px 0; }.shapes-learning-path button { display: grid; min-height: 62px; place-items: center; gap: 4px; border: 1px solid rgba(148,163,184,.16); border-radius: 5px; color: #8ea4ba; font-size: 9px; font-weight: 900; }.shapes-learning-path button span { display: grid; width: 24px; height: 24px; place-items: center; border-radius: 50%; background: #111f31; }.shapes-learning-path button.is-active { border-color: #22d3ee; background: rgba(34,211,238,.1); color: #a5f3fc; }.shapes-learning-path button.is-complete { color: #6ee7b7; }.shapes-learning-path svg { width: 13px; }.shapes-learn-card { display: grid; grid-template-columns: 160px 1fr; align-items: center; gap: 20px; min-height: 260px; border: 1px solid rgba(125,211,252,.14); border-radius: 7px; background: rgba(10,24,41,.65); padding: 24px; }.shapes-learn-card h3 { color: white; font-size: 18px; font-weight: 900; }.shapes-learn-card p { margin-top: 8px; color: #adc0d2; font-size: 12px; line-height: 1.7; }.shapes-learn-card > div > div { display: flex; gap: 8px; margin-top: 18px; }.shapes-learn-card button { min-height: 38px; border: 1px solid rgba(34,211,238,.3); border-radius: 5px; padding: 0 14px; color: #7deafa; font-size: 10px; font-weight: 900; }.shapes-learn-card button:last-child { background: #22d3ee; color: #03111d; }.shapes-precise-control { display: grid; gap: 6px; border: 1px solid transparent; border-radius: 5px; padding: 5px; transition: border-color .16s ease,background .16s ease; }.shapes-precise-control.is-highlighted { border-color: #fbbf24; background: rgba(251,191,36,.08); }.shapes-precise-control > span { display: flex; justify-content: sp