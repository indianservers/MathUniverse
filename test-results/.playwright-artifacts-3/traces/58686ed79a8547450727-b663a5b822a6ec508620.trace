 .visual-dictionary-page .glass-card .text-slate-600,\n  .visual-dictionary-page .glass-card .text-slate-700,\n  :root.dark .visual-dictionary-page .glass-card .dark\\:text-slate-200,\n  :root.dark .visual-dictionary-page .glass-card .dark\\:text-slate-300,\n  :root.dark .visual-dictionary-page .glass-card .dark\\:text-slate-400,\n  .dark .visual-dictionary-page .glass-card .dark\\:text-slate-200,\n  .dark .visual-dictionary-page .glass-card .dark\\:text-slate-300,\n  .dark .visual-dictionary-page .glass-card .dark\\:text-slate-400 {\n    color: #334155 !important;\n  }.visual-dictionary-page .glass-card button:not(.bg-cyan-300):not(.bg-slate-950),\n  .visual-dictionary-page .glass-card label,\n  .visual-dictionary-page .glass-card select {\n    color: #1e293b !important;\n  }:root.dark .visual-dictionary-page .glass-card button:not(.bg-cyan-300):not(.bg-slate-950):not(.bg-cyan-50),\n  :root.dark .visual-dictionary-page .glass-card label,\n  .dark .visual-dictionary-page .glass-card button:not(.bg-cyan-300):not(.bg-slate-950):not(.bg-cyan-50),\n  .dark .visual-dictionary-page .glass-card label {\n    border-color: rgba(148, 163, 184, 0.48) !important;\n    background-color: rgba(255, 255, 255, 0.72) !important;\n  }.visual-dictionary-page .glass-card .mini-chip,\n  :root.dark .visual-dictionary-page .glass-card .mini-chip,\n  .dark .visual-dictionary-page .glass-card .mini-chip {\n    border-color: rgba(14, 116, 144, 0.28) !important;\n    background: #cffafe !important;\n    color: #155e75 !important;\n  }.dictionary-workspace {\n    --dict-border: #dbe3ef;\n    --dict-muted: #64748b;\n    --dict-accent: #5b4ff5;\n    display: flex;\n    height: calc(100dvh - 154px);\n    min-height: 620px;\n    flex-direction: column;\n    overflow: hidden;\n    border: 1px solid var(--dict-border);\n    border-radius: 8px;\n    background: #f6f8fc;\n    color: #101a3a;\n    box-shadow: 0 12px 30px rgba(30, 64, 175, .08);\n  }.dictionary-header { display: grid; grid-template-columns: minmax(250px, .8fr) minmax(320px, 1.5fr) auto; align-items: center; gap: 16px; min-height: 70px; padding: 10px 16px; border-bottom: 1px solid var(--dict-border); background: #fff; }.dictionary-brand { display: flex; align-items: center; gap: 11px; min-width: 0; }.dictionary-brand > img { width: 42px; height: 42px; flex: 0 0 auto; -o-object-fit: contain; object-fit: contain; filter: drop-shadow(0 6px 7px rgba(57,55,191,.2)); }.dictionary-brand h1 { font-size: 18px; font-weight: 900; line-height: 1.2; }.dictionary-brand p { margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; font-weight: 600; color: var(--dict-muted); }.dictionary-search { display: flex; min-width: 0; height: 44px; align-items: center; gap: 9px; padding: 0 12px; border: 1px solid var(--dict-border); border-radius: 7px; background: #fff; box-shadow: 0 3px 10px rgba(30,64,175,.06); }.dictionary-search > svg { width: 18px; color: #53627b; }.dictionary-search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; font-size: 13px; font-weight: 600; color: #17213e; }.dictionary-search button { display: grid; width: 28px; height: 28px; place-items: center; color: #53627b; }.dictionary-search button svg { width: 16px; }.dictionary-search kbd { border: 1px solid #e0e6f0; border-radius: 4px; padding: 1px 7px; font-size: 11px; color: #718096; }.dictionary-header-actions { display: flex; align-items: stretch; gap: 2px; }.dictionary-header-actions button { display: flex; min-width: 58px; align-items: center; justify-content: center; gap: 4px; padding: 5px 7px; color: #263352; font-size: 10px; font-weight: 800; }.dictionary-header-actions svg { width: 18px; }.dictionary-header-actions button:hover { color: var(--dict-accent); }.dictionary-filterbar { display: grid; grid-template-columns: auto minmax(350px, 1fr) auto auto auto; min-height: 44px; align-items: center; gap: 9px; padding: 5px 14px; border-bottom: 1px solid var(--dict-border); background: #fbfcff; }.dictionary-count { white-space: nowrap; font-size: 11px; font-weight: 800; color: #53627b; }.dictionary-letters { display: flex; min-width: 0; justify-content: center; overflow-x: auto; scrollbar-width: none; }.dictionary-letters button { flex: 0 0 25px; height: 28px; border-radius: 5px; font-size: 11px; font-weight: 900; color: #25304e; }.dictionary-letters button[aria-pressed=\"true\"] { color: white; background: linear-gradient(135deg, #34aef0, #7154ec); }.dictionary-letters button:disabled { opacity: .25; }.dictionary-filterbar label { display: flex; height: 32px; align-items: center; gap: 5px; padding: 0 8px; border: 1px solid var(--dict-border); border-radius: 6px; background: white; }.dictionary-filterbar label svg { width: 15px; color: #52617a; }.dictionary-filterbar select { max-width: 116px; border: 0; outline: 0; background: transparent; font-size: 11px; font-weight: 800; }.dictionary-clear { font-size: 11px; font-weight: 800; color: #5448d8; }.dictionary-index-toggle { display: none; }.dictionary-columns { display: grid; min-height: 0; flex: 1; grid-template-columns: minmax(210px, 24%) minmax(420px, 50%) minmax(220px, 26%); }.dictionary-index, .dictionary-inspector { min-height: 0; background: #fff; }.dictionary-index { display: flex; flex-direction: column; border-right: 1px solid var(--dict-border); }.dictionary-panel-heading { display: flex; min-height: 42px; align-items: center; justify-content: space-between; padding: 0 12px; border-bottom: 1px solid var(--dict-border); }.dictionary-panel-heading h2, .dictionary-inspector h2 { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 900; }.dictionary-panel-heading h2 svg, .dictionary-inspector h2 svg { width: 17px; color: #5548dc; }.dictionary-panel-heading > button { display: none; }.dictionary-index-tabs { display: grid; grid-template-columns: repeat(3,1fr); border-bottom: 1px solid var(--dict-border); }.dictionary-index-tabs button { min-height: 37px; border-bottom: 2px solid transparent; text-transform: capitalize; font-size: 11px; font-weight: 800; color: #66728b; }.dictionary-index-tabs button[aria-selected=\"true\"] { border-color: #5b4ff5; color: #4438ca; }.dictionary-term-list { min-height: 0; flex: 1; overflow-y: auto; overscroll-behavior: contain; }.dictionary-term-row { display: grid; grid-template-columns: minmax(0,1fr) 32px; align-items: center; border-bottom: 1px solid #edf1f7; }.dictionary-term-row.is-selected { border-left: 3px solid #5b4ff5; background: linear-gradient(90deg, #edf8ff, #f3efff); }.dictionary-term-row > button:first-child { display: grid; min-width: 0; grid-template-columns: 48px minmax(0,1fr); align-items: center; gap: 9px; padding: 6px 5px 6px 8px; text-align: left; }.dictionary-term-row > button:last-child { display: grid; width: 30px; height: 30px; place-items: center; color: #7864e8; }.dictionary-term-row > button:last-child svg { width: 16px; }.dictionary-thumb { display: grid; width: 44px; height: 44px; place-items: center; overflow: hidden; border: 1px solid #d9e4f4; border-radius: 6px; background: linear-gradient(145deg,#f7fbff,#eef0ff); }.dictionary-thumb img { width: 42px; height: 42px; -o-object-fit: contain; object-fit: contain; filter: drop-shadow(0 3px 4px rgba(56,52,173,.14)); transition: transform .18s ease; }.dictionary-term-row:hover .dictionary-thumb img, .dictionary-term-row.is-selected .dictionary-thumb img { transform: scale(1.08); }.dictionary-term-row strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 900; }.dictionary-term-row small { display: block; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 9px; font-weight: 700; color: #718096; }.dictionary-empty { padding: 34px 18px; text-align: center; color: #64748b; }.dictionary-empty svg { margin: auto; width: 25px; }.dictionary-empty strong { display: block; margin-top: 8px; color: #17213e; }.dictionary-empty p { margin-top: 5px; font-size: 11px; }.dictionary-empty button { margin-top: 12px; color: #5145cd; font-size: 11px; font-weight: 900; }.dictionary-list-limit { padding: 10px; text-align: center; font-size: 10px; font-weight: 700; color: #64748b; }.dictionary-quick-categories { display: grid; grid-template-columns: repeat(4,1fr); align-items: center; gap: 4px; padding: 7px 8px; border-top: 1px solid var(--dict-border); font-size: 10px; font-weight: 800; }.dictionary-quick-categories > span { grid-column: 1/-1; color: #65728a; }.dictionary-quick-categories button { display: grid; min-width: 0; height: 44px; grid-template-columns: 28px minmax(0,1fr); align-items: center; gap: 3px; padding: 2px 4px; border: 1px solid var(--dict-border); border-radius: 5px; color: #3f3ab5; background: #f8faff; font-size: 8px; font-weight: 900; }.dictionary-quick-categories button img { width: 28px; height: 28px; -o-object-fit: contain; object-fit: contain; }.dictionary-quick-categories button span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.dictionary-detail { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 12px 14px; background: #fbfcff; }.dictionary-term-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 9px; }.dictionary-selected-heading { display: flex; min-width: 0; align-items: center; gap: 10px; }.dictionary-selected-heading > img { width: 52px; height: 52px; flex: 0 0 auto; -o-object-fit: contain; object-fit: contain; filter: drop-shadow(0 5px 7px rgba(65,53,190,.18)); }.dictionary-title-line { display: flex; align-items: center; gap: 8px; }.dictionary-title-line h2 { font-size: 25px; font-weight: 900; line-height: 1.1; }.dictionary-title-line > span { font-size: 11px; font-weight: 700; color: #64748b; }.dictionary-title-line button, .dictionary-term-header > div:last-child button { display: inline-flex; height: 32px; align-items: center; gap: 5px; padding: 0 8px; border: 1px solid var(--dict-border); border-radius: 6px; background: white; font-size: 10px; font-weight: 800; color: #3d4962; }.dictionary-title-line button { width: 32px; padding: 0; justify-content: center; }.dictionary-title-line svg, .dictionary-term-header button svg { width: 15px; }.dictionary-term-header > div:last-child { display: flex; gap: 5px; }.dictionary-tags { display: flex; gap: 5px; margin-top: 6px; }.dictionary-tags span { border-radius: 4px; padding: 3px 8px; background: #e6f4ff; color: #176eb6; font-size: 9px; font-weight: 900; }.dictionary-tags span + span { color: #6d3bd2; background: #efe8ff; }.dictionary-primary-visual { position: relative; min-height: 250px; overflow: hidden; border: 1px solid #243a68; border-radius: 7px; background: #06132f; }.dictionary-primary-visual > svg { min-height: 250px; height: 100%; border-radius: 0; }.dictionary-primary-visual > button { position: absolute; top: 9px; right: 9px; display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid rgba(255,255,255,.28); border-radius: 6px; color: white; background: rgba(5,15,42,.76); }.dictionary-primary-visual > button svg { width: 16px; }.dictionary-primary-visual:fullscreen { display: grid; place-items: center; width: 100vw; height: 100vh; background: #040d23; }.dictionary-primary-visual:fullscreen > svg { width: min(1200px,95vw); height: min(700px,90vh); }.dictionary-definition-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 13px 4px 4px; }.dictionary-definition-grid h3 { display: flex; align-items: center; gap: 7px; margin-bottom: 5px; font-size: 12px; font-weight: 900; }.dictionary-definition-grid h3:not(:first-child) { margin-top: 12px; }.dictionary-definition-grid h3 svg { width: 15px; color: #2e68df; }.dictionary-definition-grid p { font-size: 12px; line-height: 1.55; color: #42506a; }.dictionary-example { margin-top: 12px; padding: 10px; border: 1px solid #cde4f7; border-radius: 7px; background: #eff8ff; font-size: 12px; color: #33415d; }.dictionary-definition-grid ol { display: grid; gap: 8px; }.dictionary-definition-grid li { display: grid; grid-template-columns: 23px 1fr; align-items: start; gap: 7px; }.dictionary-definition-grid li > span { display: grid; width: 23px; height: 23px; place-items: center; border-radius: 50%; color: white; background: #3574ec; font-size: 10px; font-weight: 900; }.dictionary-notation { overflow-x: auto; padding: 10px; border: 1px solid var(--dict-border); border-radius: 6px; background: white; font-family: Georgia,serif; font-size: 15px; }.dictionary-inspector { display: flex; min-height: 0; flex-direction: column; gap: 8px; overflow-y: auto; padding: 10px; border-left: 1px solid var(--dict-border); }.dictionary-inspector section { padding: 10px; border: 1px solid var(--dict-border); border-radius: 7px; background: white; }.dictionary-inspector section > p { margin-top: 7px; font-size: 10px; line-height: 1.45; color: #52617a; }.dictionary-inspector dl { display: grid; gap: 5px; margin-top: 8px; font-size: 10px; }.dictionary-inspector dl div { display: grid; grid-template-columns: 76px 1fr; gap: 6px; }.dictionary-inspector dt { color: #65728a; }.dictionary-inspector dd { font-weight: 800; text-align: right; overflow-wrap: anywhere; }.dictionary-related { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }.dictionary-related button { display: inline-flex; min-height: 30px; align-items: center; gap: 4px; padding: 0 8px 0 4px; border: 1px solid #cdd8eb; border-radius: 6px; background: #f4f7ff; color: #31438f; font-size: 9px; font-weight: 800; }.dictionary-related button img { width: 24px; height: 24px; -o-object-fit: contain; object-fit: contain; }.dictionary-inspector section > a { display: inline-flex; align-items: center; gap: 4px; margin-top: 8px; color: #4f46d5; font-size: 10px; font-weight: 900; }.dictionary-inspector section > a svg { width: 13px; }.dictionary-practice { display: grid; grid-template-columns: 36px 1fr 36px; align-items: center; margin: 8px 0 4px; text-align: center; }.dictionary-practice button { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--dict-border); border-radius: 6px; color: #594ae2; }.dictionary-practice button svg { width: 15px; }.dictionary-practice output { font-size: 23px; font-weight: 900; color: #503ee2; }.dictionary-inspector input[type=\"range\"] { width: 100%; accent-color: #6551e8; }.dictionary-practice-feedback { min-height: 24px; padding-top: 6px; font-size: 9px; font-weight: 800; color: #64748b; }.dictionary-practice-feedback.is-correct { color: #087d57; }.dictionary-practice-feedback.is-incorrect { color: #b3451d; }.dictionary-practice-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 6px; }.dictionary-practice-actions button, .dictionary-integrations a { display: flex; min-height: 34px; align-items: center; justify-content: center; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 10px; font-weight: 900; }.dictionary-practice-actions button:last-child, .dictionary-integrations a:last-child { border-color: transparent; color: white; background: linear-gradient(135deg,#22b9e7,#794eea); }.dictionary-progress-states { display: grid; grid-template-columns: repeat(3,1fr); gap: 5px; margin-top: 8px; }.dictionary-progress-states span { padding: 6px 2px; border-radius: 5px; text-align: center; font-size: 9px; font-weight: 800; color: #718096; background: #f2f5f9; }.dictionary-progress-states span.done { color: #05734f; background: #e8f8f1; }.dictionary-integrations { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: auto; }.dictionary-integrations a { gap: 5px; color: #493ccd; background: white; }.dictionary-integrations svg { width: 14px; }.dictionary-footer { display: grid; grid-template-columns: 1fr auto 1fr minmax(330px,1.5fr); min-height: 50px; align-items: center; border-top: 1px solid var(--dict-border); background: white; }.dictionary-footer > button { display: flex; min-width: 0; height: 50px; align-items: center; gap: 8px; padding: 0 13px; border-right: 1px solid var(--dict-border); font-size: 10px; font-weight: 900; }.dictionary-footer > button:nth-child(3) { justify-content: flex-end; }.dictionary-footer > button svg { width: 15px; }.dictionary-footer > button span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.dictionary-footer small { display: block; color: #718096; font-size: 8px; }.dictionary-reading { display: flex; min-width: 0; align-items: center; justify-content: flex-end; gap: 5px; padding: 0 10px; }.dictionary-reading button { display: flex; height: 32px; min-width: 32px; align-items: center; justify-content: center; gap: 5px; border: 1px solid var(--dict-border); border-radius: 5px; padding: 0 7px; font-size: 10px; font-weight: 900; }.dictionary-reading button svg { width: 14px; }.dictionary-reading span { margin-left: 5px; white-space: nowrap; font-size: 9px; color: #64748b; }.dictionary-text-small .dictionary-detail p { font-size: 11px; }.dictionary-text-large .dictionary-detail p { font-size: 14px; line-height: 1.7; }.dictionary-workspace.is-reading .dictionary-columns { grid-template-columns: minmax(0,1fr); }.dictionary-workspace.is-reading .dictionary-index, .dictionary-workspace.is-reading .dictionary-inspector { display: none; }.dictionary-workspace.is-reading .dictionary-detail { padding-inline: max(18px, calc((100% - 900px)/2)); }@media (max-width: 1100px) {\n    .dictionary-workspace { height: calc(100dvh - 132px); min-height: 680px; }\n    .dictionary-header { grid-template-columns: minmax(220px,.8fr) minmax(280px,1.3fr); }\n    .dictionary-header-actions { display: none; }\n    .dictionary-filterbar { grid-template-columns: minmax(0,1fr) auto auto; }\n    .dictionary-count { display: none; }\n    .dictionary-letters { grid-column: 1/-1; grid-row: 2; justify-content: flex-start; }\n    .dictionary-columns { grid-template-columns: minmax(190px,27%) minmax(390px,1fr); }\n    .dictionary