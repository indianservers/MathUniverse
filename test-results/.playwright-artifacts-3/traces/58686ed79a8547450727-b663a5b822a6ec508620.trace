22d3ee_0_3px\\2c transparent_4px\\)\\2c radial-gradient\\(circle_at_80\\%_30\\%\\2c \\#f59e0b_0_3px\\2c transparent_4px\\)\\2c radial-gradient\\(circle_at_45\\%_75\\%\\2c \\#10b981_0_3px\\2c transparent_4px\\)\\]{background-image:radial-gradient(circle at 20% 20%,#22d3ee 0 3px,transparent 4px),radial-gradient(circle at 80% 30%,#f59e0b 0 3px,transparent 4px),radial-gradient(circle at 45% 75%,#10b981 0 3px,transparent 4px)}.\\[background-size\\:32px_32px\\]{background-size:32px 32px}.\\[background-size\\:80px_80px\\]{background-size:80px 80px}.\\[image-rendering\\:pixelated\\]{image-rendering:pixelated}:root {\r\n  color-scheme: light;\r\n  font-synthesis: none;\r\n  text-rendering: optimizeLegibility;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n}:root.dark {\r\n  color-scheme: dark;\r\n}body {\n  margin: 0;\n  min-width: 320px;\n  min-height: 100vh;\n  overflow-x: hidden;\n}/* Connected Math Workspaces navigation */.math-workspaces-home {\n  border: 1px solid rgb(203 213 225 / 0.9);\n  border-radius: 12px;\n  background: rgb(255 255 255 / 0.88);\n  padding: 18px;\n  box-shadow: 0 18px 45px rgb(15 23 42 / 0.08);\n}.math-workspaces-home-heading {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 14px;\n}.math-workspaces-home-heading p,\n.math-workspace-switcher-title {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: #0e7490;\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n  letter-spacing: 0;\n}.math-workspaces-home-heading h2 {\n  margin-top: 4px;\n  color: #0f172a;\n  font-size: 24px;\n  font-weight: 900;\n  line-height: 1.15;\n}.math-workspaces-home-heading > div > span {\n  display: block;\n  margin-top: 5px;\n  color: #475569;\n  font-size: 14px;\n  font-weight: 600;\n}.math-workspaces-suite-count {\n  flex: none;\n  color: #64748b;\n  font-size: 12px;\n  font-weight: 800;\n}.math-workspaces-card-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 10px;\n}.math-workspace-card {\n  position: relative;\n  display: grid;\n  grid-template-columns: 42px minmax(0, 1fr);\n  gap: 11px;\n  min-height: 168px;\n  overflow: hidden;\n  border: 1px solid #dbe3ee;\n  border-radius: 8px;\n  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);\n  padding: 15px;\n  color: #0f172a;\n  box-shadow: 0 8px 22px rgb(15 23 42 / 0.06);\n  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n}/* Premium home hero and connected studio cards */.home-live-hero { position: relative; min-height: clamp(460px,52vw,610px); overflow: hidden; border: 1px solid rgb(103 232 249 / .26); border-radius: 18px; background: radial-gradient(circle at 76% 43%,rgb(67 56 202 / .24),transparent 39%),radial-gradient(circle at 82% 55%,rgb(34 211 238 / .09),transparent 30%),linear-gradient(135deg,#061126 0%,#081735 55%,#07142d 100%); color: #fff; box-shadow: 0 24px 70px rgb(30 41 130 / .24); isolation: isolate; }.home-live-hero::before { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(rgb(56 189 248 / .055) 1px,transparent 1px),linear-gradient(90deg,rgb(99 102 241 / .055) 1px,transparent 1px); background-size: 42px 42px; -webkit-mask-image: linear-gradient(to right,transparent,black 52%); mask-image: linear-gradient(to right,transparent,black 52%); content: \"\"; }.home-live-hero::after { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg,#06132f 0%,rgb(6 19 47 / .98) 35%,rgb(6 19 47 / .78) 48%,transparent 70%); content: \"\"; pointer-events: none; }.home-live-scene { position: absolute; inset: 0 0 0 32%; }.home-live-scene canvas { cursor: grab; touch-action: none; }.home-live-scene canvas:active { cursor: grabbing; }.home-live-copy { position: relative; z-index: 2; width: min(620px,52%); padding: clamp(36px,5vw,68px) 0 46px clamp(28px,4vw,56px); pointer-events: none; }.home-live-kickers { display: flex; flex-wrap: wrap; gap: 8px; }.home-live-kickers span { display: inline-flex; min-height: 30px; align-items: center; gap: 6px; border: 1px solid rgb(103 232 249 / .3); border-radius: 999px; background: rgb(8 47 73 / .62); padding: 0 11px; color: #a5f3fc; font-size: 10px; font-weight: 850; }.home-live-kickers svg { width: 14px; }.home-live-copy h1 { margin-top: 28px; font-size: clamp(44px,5vw,72px); font-weight: 950; line-height: .98; letter-spacing: 0; }.home-live-copy p { max-width: 520px; margin-top: 24px; color: #cbd5e1; font-size: clamp(15px,1.5vw,20px); font-weight: 650; line-height: 1.6; }.home-live-actions { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 28px; pointer-events: auto; }.home-live-actions a { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 8px; border-radius: 6px; background: linear-gradient(90deg,#0ea5e9,#8b5cf6); padding: 0 18px; font-size: 12px; font-weight: 900; box-shadow: 0 10px 24px rgb(14 165 233 / .22); }.home-live-actions a.secondary { border: 1px solid rgb(255 255 255 / .25); background: rgb(15 23 42 / .58); box-shadow: none; }.home-live-equation { position: absolute; z-index: 3; top: 38px; right: 34px; display: grid; justify-items: end; color: #ddd6fe; font-family: Georgia,serif; pointer-events: auto; }.home-live-equation strong { font-size: clamp(16px,1.6vw,24px); font-weight: 500; }.home-live-equation strong i { display: inline-block; width: 9px; height: 9px; margin-right: 9px; border-radius: 50%; background: linear-gradient(135deg,#22d3ee,#8b5cf6); box-shadow: 0 0 12px rgb(34 211 238 / .7); vertical-align: .12em; }.home-live-equation span { margin-top: 9px; color: #94a3b8; font-size: 12px; }.home-live-equation button { margin-top: 9px; color: #67e8f9; font: 800 9px ui-sans-serif,sans-serif; text-transform: uppercase; }.home-live-controls { position: absolute; z-index: 3; right: 24px; bottom: 22px; display: flex; gap: 8px; }.home-live-controls button,.home-live-controls a { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: 8px; border: 1px solid rgb(255 255 255 / .3); border-radius: 6px; background: rgb(15 23 42 / .72); padding: 0 14px; font-size: 11px; font-weight: 900; backdrop-filter: blur(10px); }.home-live-controls button { width: 44px; padding: 0; }.home-live-controls svg { width: 16px; }@media (forced-colors: active) { .home-live-equation strong i { border: 2px solid CanvasText; background: Canvas; box-shadow: none; } }@media (prefers-reduced-motion: reduce) { .home-live-scene canvas { cursor: default; } }.home-path-section { border: 1px solid #dbe3ef; border-radius: 8px; background: rgb(255 255 255 / .88); padding: 17px 20px 20px; box-shadow: 0 10px 30px rgb(15 23 42 / .06); }.home-path-heading span { color: #0891b2; font-size: 10px; font-weight: 900; text-transform: uppercase; }.home-path-heading h2 { margin-top: 3px; color: #0f172a; font-size: 20px; font-weight: 900; }.home-path-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; margin-top: 13px; }.home-path-card { display: grid; grid-template-columns: 68px minmax(0,1fr); gap: 15px; min-height: 126px; align-items: center; border: 1px solid color-mix(in srgb,var(--path-accent) 55%,#cbd5e1); border-radius: 7px; background: #fff; padding: 16px; transition: transform .18s,box-shadow .18s; }.home-path-card:hover { transform: translateY(-2px); box-shadow: 0 14px 30px color-mix(in srgb,var(--path-accent) 14%,transparent); }.home-path-card.is-student { --path-accent:#14b8a6; }.home-path-card.is-teacher { --path-accent:#2563eb; }.home-path-card.is-explorer { --path-accent:#9333ea; }.home-path-icon { display: grid; width: 68px; height: 68px; place-items: center; border-radius: 7px; background: var(--path-accent); color: #fff; }.home-path-icon svg { width: 32px; height: 32px; }.home-path-card strong,.home-path-card small,.home-path-card b { display: block; }.home-path-card strong { color: #0f172a; font-size: 15px; font-weight: 900; }.home-path-card small { margin-top: 5px; color: #64748b; font-size: 11px; line-height: 1.5; }.home-path-card b { display: flex; align-items: center; gap: 5px; margin-top: 9px; color: var(--path-accent); font-size: 11px; font-weight: 900; }.home-path-card b svg { width: 14px; }.math-workspaces-home { padding: 22px; border-radius: 10px; background: rgb(255 255 255 / .94); }.math-workspaces-card-grid { grid-auto-rows: 1fr; gap: 14px; }.math-workspace-card { grid-template-columns: 84px minmax(0,1fr); grid-template-rows: 1fr auto; gap: 10px 16px; min-height: 232px; overflow: hidden; border-radius: 7px; padding: 20px; background: linear-gradient(145deg,#fff,#fbfdff); }.math-workspace-card::before { width: 2px; }.math-workspace-card-formula { position: absolute; top: 10px; right: 12px; max-width: 170px; color: color-mix(in srgb,var(--workspace-accent) 13%,transparent); font: italic 20px Georgia,serif; pointer-events: none; }.math-workspace-card .math-workspace-card-icon { z-index: 1; width: 84px; height: 84px; overflow: hidden; border-radius: 8px; border-color: color-mix(in srgb,var(--workspace-accent) 30%,#e2e8f0); background: #fff; box-shadow: 0 8px 22px color-mix(in srgb,var(--workspace-accent) 12%,transparent); }.math-workspace-card-icon img { width: 100%; height: 100%; -o-object-fit: cover; object-fit: cover; }.math-workspace-card-copy { z-index: 1; min-width: 0; padding-top: 8px; }.math-workspace-card-title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }.math-workspace-card-title strong { font-size: 17px; }.math-workspace-card-title em { border-radius: 999px; background: color-mix(in srgb,var(--workspace-accent) 11%,white); padding: 4px 8px; color: var(--workspace-accent); font-size: 9px; font-style: normal; font-weight: 900; }.math-workspace-card small { max-width: 290px; margin-top: 10px; font-size: 13px; line-height: 1.55; }.math-workspace-card-action { grid-column: 1 / -1; width: -moz-fit-content; width: fit-content; min-width: 184px; min-height: 40px; justify-content: space-between; border: 1px solid color-mix(in srgb,var(--workspace-accent) 50%,#cbd5e1); border-radius: 6px; background: color-mix(in srgb,var(--workspace-accent) 5%,white); padding: 0 13px; }.math-workspace-card::before {\n  position: absolute;\n  inset: 0 auto 0 0;\n  width: 3px;\n  background: var(--workspace-accent);\n  content: \"\";\n}.math-workspace-card:hover {\n  border-color: color-mix(in srgb, var(--workspace-accent) 55%, #cbd5e1);\n  box-shadow: 0 15px 32px color-mix(in srgb, var(--workspace-accent) 15%, transparent);\n  transform: translateY(-2px);\n}.math-workspace-card:focus-visible,\n.math-workspace-switcher-trigger:focus-visible,\n.math-workspace-switcher-item:focus-visible {\n  outline: 3px solid color-mix(in srgb, var(--workspace-accent, #06b6d4) 45%, transparent);\n  outline-offset: 2px;\n}.math-workspace-card-icon,\n.math-workspace-current-icon,\n.math-workspace-menu-icon {\n  display: grid;\n  place-items: center;\n  flex: none;\n  width: 42px;\n  height: 42px;\n  border: 1px solid color-mix(in srgb, var(--workspace-accent) 30%, #e2e8f0);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--workspace-accent) 10%, white);\n  color: var(--workspace-accent);\n}.math-workspace-card strong,\n.math-workspace-switcher-item strong {\n  display: block;\n  font-size: 15px;\n  font-weight: 900;\n}.math-workspace-card small {\n  display: block;\n  margin-top: 5px;\n  color: #64748b;\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 1.55;\n}.math-workspace-card-action {\n  grid-column: 1 / -1;\n  align-self: end;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--workspace-accent);\n  font-size: 12px;\n  font-weight: 900;\n}.math-workspace-chrome {\n  position: relative;\n  z-index: 70;\n  display: flex;\n  min-height: 48px;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  border: 1px solid #dbe3ee;\n  border-radius: 8px;\n  background: rgb(255 255 255 / 0.96);\n  padding: 5px 7px 5px 12px;\n  color: #0f172a;\n  box-shadow: 0 12px 30px rgb(15 23 42 / 0.14);\n  backdrop-filter: blur(18px);\n}.math-workspace-layout {\n  --workspace-dock-height: 62px;\n  container-name: math-workspace;\n  container-type: inline-size;\n  display: grid;\n  grid-template-rows: max(58px, calc(48px + env(safe-area-inset-top))) minmax(0, 1fr) calc(var(--workspace-dock-height) + env(safe-area-inset-bottom));\n  width: 100%;\n  height: 100dvh;\n  min-width: 0;\n  overflow: hidden;\n  padding-right: env(safe-area-inset-right);\n  padding-left: env(safe-area-inset-left);\n  background: #030914;\n  overscroll-behavior: none;\n}.math-workspace-layout > .math-workspace-chrome {\n  z-index: 75;\n  min-width: 0;\n  border-width: 0 0 1px;\n  border-radius: 0;\n  padding-top: max(5px, env(safe-area-inset-top));\n  box-shadow: 0 8px 24px rgb(15 23 42 / .12);\n}.math-workspace-stage {\n  position: relative;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  isolation: isolate;\n}.math-workspace-stage > .h-dvh,\n.math-workspace-stage > .shapes-studio-shell,\n.math-workspace-stage > .graph-studio-3d-shell {\n  height: 100%;\n  min-height: 0;\n}.math-workspace-mobile-dock {\n  z-index: 80;\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  min-width: 0;\n  border-top: 1px solid #dbe3ee;\n  background: rgb(255 255 255 / .98);\n  padding: 3px max(4px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(4px, env(safe-area-inset-left));\n  box-shadow: 0 -10px 28px rgb(15 23 42 / .15);\n}.math-workspace-mobile-dock a,\n.math-workspace-mobile-dock button {\n  display: flex;\n  min-width: 0;\n  min-height: 54px;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n  gap: 2px;\n  border-radius: 6px;\n  color: #475569;\n  font-size: 9px;\n  font-weight: 850;\n}.math-workspace-mobile-dock svg { width: 20px; height: 20px; }.math-workspace-mobile-dock :is(a,button):active,\n.math-workspace-mobile-dock button.is-act