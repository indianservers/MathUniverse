  "lesson": {
    "lessonId": "afd1906c-12c5-4341-9953-8fa6fcf8d392",
    "title": "Explore Parabolas with a, b and c",
    "shortDescription": "Use sliders to connect quadratic coefficients to shape, axis and intercepts.",
    "subject": "Mathematics",
    "workspaceType": "2d-graph",
    "topic": "Algebra",
    "subtopic": "Quadratic functions",
    "difficulty": "intermediate",
    "gradeLevel": [
      "8",
      "9",
      "10"
    ],
    "learningObjectives": [
      "Students explain a controls opening/width, b shifts the axis, and c is the y-intercept; the sample solution has vertex (2,−1)."
    ],
    "prerequisites": [
      "Basic coordinate and algebra fluency"
    ],
    "instructions": [
      "Vary a and record the opening and width.",
      "Vary b and observe the axis of symmetry.",
      "Vary c and identify the y-intercept."
    ],
    "hints": [
      "The sign of a determines whether the parabola opens up or down.",
      "The axis is x = −b/(2a).",
      "At x=0, the function value is c."
    ],
    "checkpoints": [],
    "solutionSteps": [
      "Set a=1, b=−4 and c=3.",
      "Compute the axis x=2.",
      "Evaluate f(2)=−1 to locate the vertex.",
      "Confirm the y-intercept is (0,3)."
    ],
    "expectedResult": "Students explain a controls opening/width, b shifts the axis, and c is the y-intercept; the sample solution has vertex (2,−1).",
    "teacherNotes": "Invite students to explain why the visual and symbolic results agree.",
    "estimatedDurationMinutes": 20,
    "maximumScore": 100,
    "attemptLimit": null,
    "allowSolutionView": true,
    "tags": [
      "quadratic",
      "parabola",
      "sliders",
      "vertex"
    ],
