  "lesson": {
    "lessonId": "90d75f92-f4ee-4e48-861c-35fa980fb597",
    "title": "Solve and Verify a Quadratic Equation",
    "shortDescription": "Factor, solve and substitute to verify x² − 5x + 6 = 0.",
    "subject": "Mathematics",
    "workspaceType": "cas",
    "topic": "Algebra",
    "subtopic": "Quadratic equations",
    "difficulty": "intermediate",
    "gradeLevel": [
      "8",
      "9"
    ],
    "learningObjectives": [
      "The exact solutions are x = 2 and x = 3, and both substitutions return zero."
    ],
    "prerequisites": [
      "Basic coordinate and algebra fluency"
    ],
    "instructions": [
      "Factor the polynomial.",
      "Use the zero-product property.",
      "Substitute each root into the original equation."
    ],
    "hints": [
      "Find two numbers whose product is 6 and sum is −5.",
      "The factors are (x−2) and (x−3).",
      "A valid root makes the original left side equal zero."
    ],
    "checkpoints": [],
    "solutionSteps": [
      "Factor x²−5x+6 as (x−2)(x−3).",
      "Set each factor equal to zero.",
      "Obtain x=2 and x=3.",
      "Substitute both values and verify the output is 0."
    ],
    "expectedResult": "The exact solutions are x = 2 and x = 3, and both substitutions return zero.",
    "teacherNotes": "Invite students to explain why the visual and symbolic results agree.",
    "estimatedDurationMinutes": 20,
    "maximumScore": 100,
    "attemptLimit": null,
    "allowSolutionView": true,
