  "lesson": {
    "lessonId": "ff2eb145-c891-4795-ae5d-72668220ccd7",
    "title": "Explore z = sin(x)cos(y)",
    "shortDescription": "Investigate periodic peaks, troughs, zeros and cross-sections of a trigonometric surface.",
    "subject": "Mathematics",
    "workspaceType": "3d-graph",
    "topic": "Functions",
    "subtopic": "3D trigonometric surfaces",
    "difficulty": "intermediate",
    "gradeLevel": [
      "10",
      "11",
      "12"
    ],
    "learningObjectives": [
      "The surface ranges from −1 to 1, repeats periodically, and has grid-like zero curves with sine/cosine cross-sections."
    ],
    "prerequisites": [
      "Basic coordinate and algebra fluency"
    ],
    "instructions": [
      "Rotate the surface and locate peaks and troughs.",
      "Find lines where z=0.",
      "Enable a slice and compare it with a sine or cosine graph."
    ],
    "hints": [
      "The maximum possible product is 1.",
      "The surface is zero whenever sin(x)=0 or cos(y)=0.",
      "At y=0, the cross-section is z=sin(x)."
    ],
    "checkpoints": [],
    "solutionSteps": [
      "Use the range −4≤x,y≤4.",
      "Identify maxima such as (π/2,0,1) and neighboring troughs.",
      "Note zero lines x=kπ and y=π/2+kπ.",
      "Slice at x=π/2 to view z=cos(y)."
    ],
    "expectedResult": "The surface ranges from −1 to 1, repeats periodically, and has grid-like zero curves with sine/cosine cross-sections.",
    "teacherNotes": "Invite students to explain why the visual and symbolic results agree.",
    "estimatedDurationMinutes": 20,
    "maximumScore": 100,
    "attemptLimit": null,
    "allowSolutionView": true,
