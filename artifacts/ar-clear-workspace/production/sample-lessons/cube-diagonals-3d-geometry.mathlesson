  "lesson": {
    "lessonId": "6cd1eedb-ae92-45d6-bac9-49cdc74e3c8a",
    "title": "Cube Face and Space Diagonals",
    "shortDescription": "Compare face diagonals with the diagonal passing through the cube's interior.",
    "subject": "Mathematics",
    "workspaceType": "3d-geometry",
    "topic": "Solid Geometry",
    "subtopic": "Cube diagonals",
    "difficulty": "intermediate",
    "gradeLevel": [
      "8",
      "9",
      "10"
    ],
    "learningObjectives": [
      "For a cube of side 3, face diagonals have length 3√2 and space diagonals have length 3√3."
    ],
    "prerequisites": [
      "Basic coordinate and algebra fluency"
    ],
    "instructions": [
      "Identify a diagonal on one square face.",
      "Create a diagonal joining opposite cube vertices.",
      "Compare their lengths for side length 3."
    ],
    "hints": [
      "A face diagonal stays within one square face.",
      "Use the Pythagorean theorem twice.",
      "For side s, face diagonal = s√2 and space diagonal = s√3."
    ],
    "checkpoints": [],
    "solutionSteps": [
      "Draw a face diagonal and compute √(3²+3²)=3√2.",
      "Combine that diagonal with a perpendicular edge.",
      "Compute √((3√2)²+3²)=3√3."
    ],
    "expectedResult": "For a cube of side 3, face diagonals have length 3√2 and space diagonals have length 3√3.",
    "teacherNotes": "Invite students to explain why the visual and symbolic results agree.",
    "estimatedDurationMinutes": 20,
    "maximumScore": 100,
    "attemptLimit": null,
    "allowSolutionView": true,
    "tags": [
      "cube",
      "diagonal",
      "pythagoras",
      "3d"
    ],
