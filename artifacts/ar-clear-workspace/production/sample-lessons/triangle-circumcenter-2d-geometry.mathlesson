  "lesson": {
    "lessonId": "32139765-07e5-4b12-a448-4b6996b2ccaa",
    "title": "Construct a Triangle Circumcenter",
    "shortDescription": "Build perpendicular bisectors and locate the unique point equidistant from all vertices.",
    "subject": "Mathematics",
    "workspaceType": "2d-geometry",
    "topic": "Geometry",
    "subtopic": "Triangle centers",
    "difficulty": "intermediate",
    "gradeLevel": [
      "8",
      "9"
    ],
    "learningObjectives": [
      "The perpendicular bisectors meet at circumcenter O, which is equidistant from A, B and C."
    ],
    "prerequisites": [
      "Basic coordinate and algebra fluency"
    ],
    "instructions": [
      "Construct the midpoint of at least two sides.",
      "Draw perpendicular bisectors through those midpoints.",
      "Mark their intersection as O and explain why OA = OB = OC."
    ],
    "hints": [
      "A perpendicular bisector passes through a side's midpoint.",
      "Two nonparallel perpendicular bisectors are enough to locate O.",
      "Every point on a perpendicular bisector is equidistant from that side's endpoints."
    ],
    "checkpoints": [
      {
        "id": "geo-cp-1",
        "title": "Two midpoints",
        "instructions": "Create midpoints on two sides.",
